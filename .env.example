# Required
OPENAI_API_KEY=your_openai_api_key_here

# Required for search tools
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: LangSmith tracing (recommended)
# Set LANGSMITH_TRACING=true only once LANGSMITH_API_KEY is a valid, active key —
# an invalid/expired key doesn't block notebook execution but spams every cell's
# output with "403 Forbidden" trace-ingestion errors.
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=oreilly-langchain
